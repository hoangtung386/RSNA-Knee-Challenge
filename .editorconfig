# https://editorconfig.org — giữ định dạng nhất quán giữa các IDE
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # hai khoảng trắng cuối dòng = xuống dòng trong Markdown

[Makefile]
indent_style = tab
